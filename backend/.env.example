# Copy to .env.local and fill in. The defaults below are mock-mode — the whole
# system runs end to end without real Pinch credentials.
#
# Both .env and .env.local are read, and .env.local wins. Both are gitignored;
# only this template is committed.

# mock = outbound Pinch calls go to the simulator. live = really call Pinch.
PINCH_MODE=mock

# --- Credentials -------------------------------------------------------------
# From the API Keys section of https://web.getpinch.com.au/api-keys.
# There is no separate sandbox account: one credential set serves both test and
# live, and PINCH_API_BASE below decides which environment you reach.
# Only consulted when PINCH_MODE=live.

# OAuth2 client_id.
PINCH_APPLICATION_ID=
# OAuth2 client_secret. Server-side only — never expose this in a browser.
PINCH_SECRET_KEY=
# Client-side key for CaptureJS tokenisation (pk_test_...). Safe to expose.
PINCH_PUBLISHABLE_KEY=

# --- Endpoints ---------------------------------------------------------------
# Token exchange host (OAuth2 client_credentials).
PINCH_AUTH_BASE=https://auth.getpinch.com.au

# WARNING: /test/ and /live/ accept the SAME credentials. Swapping this one
# path segment is all it takes to move real money against real bank accounts.
# Leave it on /test/ for the hackathon.
#   test -> https://api.getpinch.com.au/test/
#   live -> https://api.getpinch.com.au/live/
PINCH_API_BASE=https://api.getpinch.com.au/test/

# Required on every Pinch request.
PINCH_VERSION=2020.1

# --- Database ----------------------------------------------------------------
# psycopg 3 driver. Matches `docker compose up -d db` in the README.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pinch_recovery
